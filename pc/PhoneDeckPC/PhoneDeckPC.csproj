<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK : nécessaire pour lire le morceau en cours (contrôles média de Windows). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>KeyraDeck</AssemblyName>
    <RootNamespace>PhoneDeckPC</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <!-- Version.Build = numéro de build, comparé par la mise à jour automatique : ne pas changer. -->
    <Version>0.3.$(BuildNumber)</Version>
    <!-- Version affichée (0.0.1, 0.0.2…), calculée par .github/version.sh. -->
    <DisplayVersion Condition="'$(DisplayVersion)' == ''">dev</DisplayVersion>
    <InformationalVersion>$(DisplayVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>KeyraDeck</Product>
    <AssemblyTitle>KeyraDeck</AssemblyTitle>
    <Description>KeyraDeck</Description>
    <Company>KeyraDeck</Company>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot/config.html" LogicalName="config.html" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
